{
  "name": "humanwrite",
  "version": "1.0.0",
  "private": true,
  "description": "HumanWrite — a structural writing studio with editorial intelligence. Standalone live web application.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node --max-old-space-size=3072 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^6.1.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "@tiptap/extension-underline": "^2.10.0",
    "@tiptap/extension-link": "^2.10.0",
    "@tiptap/extension-placeholder": "^2.10.0",
    "@supabase/supabase-js": "^2.47.0",
    "@supabase/ssr": "^0.5.2",
    "docx": "^9.1.0",
    "mammoth": "^1.8.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
