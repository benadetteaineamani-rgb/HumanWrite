# ---- AI provider (§2, §7). Server-only. NEVER expose to the browser. ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model routing by depth (§7, §8). Override to tune cost/quality.
EDITORIAL_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001
DEEP_REVIEW_MODEL=claude-sonnet-4-6

# ---- Database (§13). Managed PostgreSQL (Supabase, Neon, RDS, etc). ----
DATABASE_URL=postgresql://user:password@host:5432/humanwrite

# ---- Auth (§14). Supabase. The anon key is browser-safe; the service key is NOT used client-side. ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- App ----
NODE_ENV=development
